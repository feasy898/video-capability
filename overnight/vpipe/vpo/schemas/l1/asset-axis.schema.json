{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpo.example/schemas/v1/l1/asset-axis.schema.json",
  "$comment": "AssetAxis: Asset > AssetVariant > ShotCasting. ShotGrid/Kitsu-style many-to-many breakdown. OMC SC/FC dual track is a reference for AssetVariant, not a copy of OMC types. Source: E2, OMC, ShotGrid.",
  "title": "AssetAxis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "axis_id",
    "assets"
  ],
  "properties": {
    "axis_id": {
      "type": "string",
      "format": "uuid"
    },
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "castings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/shot_casting"
      }
    }
  },
  "$defs": {
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifiers",
        "asset_kind"
      ],
      "properties": {
        "identifiers": {
          "allOf": [
            {
              "$ref": "https://vpo.example/schemas/v1/common/identifiers.schema.json"
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scene_code"
                ]
              },
              {
                "required": [
                  "sceneStableId"
                ]
              },
              {
                "required": [
                  "sceneInsertPrefix"
                ]
              },
              {
                "required": [
                  "setupLetter"
                ]
              },
              {
                "required": [
                  "takeNumber"
                ]
              },
              {
                "required": [
                  "unitCode"
                ]
              },
              {
                "required": [
                  "flags"
                ]
              }
            ]
          }
        },
        "asset_kind": {
          "type": "string",
          "enum": [
            "character",
            "wardrobe",
            "prop",
            "environment",
            "vehicle",
            "vfx",
            "audio",
            "graphic"
          ]
        },
        "variants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/variant"
          }
        }
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifiers",
        "revision"
      ],
      "properties": {
        "identifiers": {
          "allOf": [
            {
              "$ref": "https://vpo.example/schemas/v1/common/identifiers.schema.json"
            }
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "scene_code"
                ]
              },
              {
                "required": [
                  "sceneStableId"
                ]
              },
              {
                "required": [
                  "sceneInsertPrefix"
                ]
              },
              {
                "required": [
                  "setupLetter"
                ]
              },
              {
                "required": [
                  "takeNumber"
                ]
              },
              {
                "required": [
                  "unitCode"
                ]
              },
              {
                "required": [
                  "flags"
                ]
              }
            ]
          }
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        },
        "label": {
          "type": "string"
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "content_hash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "shot_casting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "editorial_shot_id",
        "asset_id",
        "variant_id"
      ],
      "properties": {
        "editorial_shot_id": {
          "type": "string",
          "format": "uuid"
        },
        "asset_id": {
          "type": "string",
          "format": "uuid"
        },
        "variant_id": {
          "type": "string",
          "format": "uuid"
        },
        "role": {
          "type": "string"
        }
      }
    }
  }
}
