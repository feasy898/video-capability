{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpo.example/schemas/v1/l2/performance-intent.schema.json",
  "$comment": "source: E6 beat.verify. L2 is tool-neutral: no model names, software names, node graphs, plugin names, or vendor parameter names. Enums are L0 concept_id strings. Numeric fields need unit + measurement_basis. Time intervals are half-open OTIO [start,end). Versions must not be the string latest. Frame-level performance verification is not a machine field. advisory_signals are L0 concept ids (vpo:motion.advisory_signal.*).",
  "title": "PerformanceIntent",
  "allOf": [
    {
      "$ref": "https://vpo.example/schemas/v1/common/intent-common.schema.json"
    }
  ],
  "type": "object",
  "required": [
    "intent_type",
    "beats"
  ],
  "properties": {
    "intent_type": {
      "type": "string",
      "const": "vpo:craft.intent_object.performance_intent"
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "anchor",
          "window_ms",
          "unit",
          "emotion_label"
        ],
        "properties": {
          "anchor": {
            "type": "string",
            "minLength": 1,
            "$comment": "Dialogue token string (word-level)."
          },
          "token_index": {
            "type": "integer",
            "minimum": 0
          },
          "vo_token": {
            "type": "string",
            "minLength": 1,
            "$comment": "Word-level VO/dialogue token bound to this beat window."
          },
          "window_ms": {
            "type": "integer",
            "minimum": 0
          },
          "unit": {
            "type": "string",
            "const": "ms"
          },
          "emotion_label": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "gate",
              "human_required"
            ],
            "$comment": "E6: beat.verify carries its own emotion sign-off (human_required); one per beat.",
            "properties": {
              "gate": {
                "type": "string",
                "const": "vpo:delivery.gate.human"
              },
              "human_required": {
                "type": "boolean",
                "const": true
              }
            }
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "vpo:motion.advisory_signal.rms_rise",
                "vpo:motion.advisory_signal.au12_drop"
              ]
            },
            "$comment": "Advisory beat signals, L0 concept ids."
          },
          "emotion": {
            "type": "string",
            "pattern": "^vpo:mood\\.bodily_expressivity\\.[a-z_]+(\\.[a-z_]+)?$",
            "$comment": "Per-beat performed emotion content (bodily-expressivity vocabulary); the human sign-off gate stays on emotion_label."
          },
          "action_units": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^vpo:mood\\.facs_au\\.[a-z0-9_]+$"
            },
            "$comment": "Anatomical facial control orthogonal to emotion labels (drama-series storyboard FACS lexicon); human sign-off gate unchanged."
          }
        }
      }
    }
  },
  "unevaluatedProperties": false
}
