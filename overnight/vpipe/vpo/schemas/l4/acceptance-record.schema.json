{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vpo.example/schemas/v1/l4/acceptance-record.schema.json",
  "$comment": "AcceptanceRecord is written after execution. unknown ≠ pass. inconclusive is a legal terminal state. approved_exception requires reviewer_or_approval_ref and must not be self-approved by the executing agent. Provenance is not a correctness proof. Source: E6, G2.",
  "title": "AcceptanceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "criterion_ref",
    "artifact_ref",
    "artifact_revision",
    "status",
    "evaluator_id",
    "evaluator_version"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "https://vpo.example/schemas/v1/l4/acceptance-record.schema.json"
    },
    "criterion_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "version"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "not": {
            "const": "latest"
          }
        }
      }
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1
    },
    "artifact_revision": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "latest"
      }
    },
    "target_ref": {
      "type": "string"
    },
    "time_range": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "time_base": {
          "type": "object",
          "required": [
            "rate_num",
            "rate_den"
          ],
          "additionalProperties": false,
          "properties": {
            "rate_num": {
              "type": "integer",
              "minimum": 1
            },
            "rate_den": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "start_frame": {
          "type": "integer",
          "minimum": 0
        },
        "end_frame": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "expected": true,
    "observed": true,
    "status": {
      "type": "string",
      "pattern": "^vpo:delivery\\.record_status\\.(pass|fail|unknown|approved_exception|inconclusive)$"
    },
    "evaluator_id": {
      "type": "string",
      "minLength": 1
    },
    "evaluator_version": {
      "type": "string",
      "minLength": 1,
      "not": {
        "const": "latest"
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "$comment": "G2 third number. Not tolerance, not measurement_uncertainty."
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "reviewer_or_approval_ref": {
      "type": "string"
    },
    "treated_as": {
      "type": "string",
      "enum": [
        "vpo:delivery.record_status.pass",
        "vpo:delivery.record_status.fail"
      ],
      "$comment": "Trap field for unknown-must-not-be-treated-as-pass; uses the L0 record_status vocabulary."
    },
    "gate_result": {
      "type": "string",
      "enum": [
        "vpo:delivery.record_status.pass",
        "vpo:delivery.record_status.fail"
      ],
      "$comment": "Trap field for unknown-must-not-be-treated-as-pass; uses the L0 record_status vocabulary."
    }
  },
  "if": {
    "properties": {
      "status": {
        "const": "vpo:delivery.record_status.approved_exception"
      }
    }
  },
  "then": {
    "required": [
      "reviewer_or_approval_ref"
    ]
  }
}
